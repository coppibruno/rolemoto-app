# Firebase - Copie este arquivo para .env.local e preencha com suas credenciais
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push — Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Cloud Functions HTTP (opcional — o default já aponta para o emulator em dev)
# NEXT_PUBLIC_FUNCTIONS_URL=http://127.0.0.1:5001/rolemoto-bc47f/us-central1/api

# Storage local (evita CORS no bucket de produção). Requer `npm run emulators`.
# Local: 127.0.0.1:9199 — pelo ngrok HTTPS da app, o Next faz proxy /v0 → 9199.
# Túnel próprio do emulator: https://xxxx.ngrok-free.app (sem path).
# NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Capacitor — URL carregada no WebView nativo (dev: IP da LAN ou ngrok; prod: site)
# CAPACITOR_SERVER_URL=http://192.168.0.10:3000
