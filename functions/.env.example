# Origin do PWA (sem barra final). Usado no continueUrl do reset, no clique do push
# e como origin adicional no CORS da API.
APP_ORIGIN=http://localhost:3000

# Mesma Web API key do app (NEXT_PUBLIC_FIREBASE_API_KEY).
# Necessária para POST /auth/recuperar-senha disparar o e-mail nativo do Auth.
WEB_API_KEY=

# URL base da function `api` (sem barra final). Usada no Cloud Tasks (OIDC audience).
# Produção: https://us-central1-rolemoto-bc47f.cloudfunctions.net/api
# FUNCTIONS_BASE_URL=https://us-central1-rolemoto-bc47f.cloudfunctions.net/api

# Push FCM: no emulator (`FUNCTIONS_EMULATOR=true`, setado pelo Firebase CLI)
# o envio é ignorado para não notificar usuários reais. Em produção o envio segue.

# Cloud Scheduler (04:00 America/Sao_Paulo) chama
# POST {FUNCTIONS_BASE_URL}/interno/stories/expirar
# com o header X-Cron-Secret. Sem valor real neste exemplo.
STORIES_CRON_SECRET=

# Places API (New). Só na function. A tela admin também dispara a busca.
# Cron: POST {FUNCTIONS_BASE_URL}/interno/sugestoes-locais/buscar
# Header X-Cron-Secret = STORIES_CRON_SECRET
# Sugestão: segunda 06:00 America/Sao_Paulo.
PLACES_API_KEY=

# Opcional. Gemini filtra mirante genérico e fica com destino de moto
# (Serra do Rio do Rastro e equivalentes). Sem a chave, só entra lugar
# cujo nome casa com a rota da rodada.
# Sem GEMINI_MODEL o modelo é gemini-3.5-flash-lite.
# GEMINI_MODEL troca o nome. 3.5, 3.7 e 3.8 Flash continuam no Lite.
# A rodada de eventos do Instagram exige esta chave. Sem ela, essa fonte volta bloqueada.
GEMINI_API_KEY=

# Instagram API com login do Facebook (graph.facebook.com v27.0).
# Conta @rolemotobr. Sem o token, a rodada do Instagram volta bloqueada e o MotoClub segue.
# Produção: secret INSTAGRAM_ACCESS_TOKEN no Firebase. Não vai no client nem no Git.
# Permissões: instagram_basic, pages_show_list, pages_read_engagement.
INSTAGRAM_ACCESS_TOKEN=
