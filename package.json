{
  "name": "rolemoto-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "emulators": "npm --prefix functions run build && npx -y firebase-tools@latest emulators:start --only functions,storage",
    "emulators:all": "npm --prefix functions run build && npx -y firebase-tools@latest emulators:start --only functions,firestore,auth,storage",
    "storage:cors": "gcloud storage buckets update gs://rolemoto-bc47f.firebasestorage.app --cors-file=cors.json --project=rolemoto-bc47f"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "firebase": "^12.18.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serwist": "^9.5.12",
    "typescript": "^5.7.0"
  }
}
