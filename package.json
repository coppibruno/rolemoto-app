{
  "name": "rolemoto-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "npm --prefix functions run build && npx -y firebase-tools@latest emulators:start --only functions,storage",
    "emulators:all": "npm --prefix functions run build && npx -y firebase-tools@latest emulators:start --only functions,firestore,auth,storage",
    "storage:cors": "gcloud storage buckets update gs://rolemoto-bc47f.firebasestorage.app --cors-file=cors.json --project=rolemoto-bc47f"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/background-geolocation": "^8.4.6",
    "@sentry/nextjs": "^10.74.0",
    "@serwist/next": "^9.5.12",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serwist": "^9.5.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
